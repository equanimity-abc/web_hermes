# ============================================================
# AI 漫剧制作流水线 · 环境变量示例（复制为 .env 后按需填写）
# ============================================================

# ---------- LLM：剧本 / 分镜（DeepSeek ↔ Kimi 可互相替代）----------
# 有任一 Key 即可写剧本；两者都配则优先 models.script.provider，失败自动换另一家
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

KIMI_API_KEY=
# 兼容别名：MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# ---------- 火山方舟 Ark（文本 / 生图 / 视频 / 音频）----------
# 也可在前端「API 设置」写入 backend/data/secrets.json
ARK_API_KEY=
# 兼容别名：VOLCENGINE_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TEXT_MODEL=doubao-seed-character-260628
ARK_TEXT_MODEL_ALT=glm-5-2-260617
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
ARK_AUDIO_MODEL=doubao-seed-audio-1-0

# ---------- 阿里云百炼（DashScope：出图 / 图生视频 / 配音）----------
# 一个 Key 覆盖出图(qwen-image-plus)、图生视频(wanx2.1-i2v-turbo)、高拟真配音(qwen TTS)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=qwen-image-plus
DASHSCOPE_I2V_MODEL=wanx2.1-i2v-turbo
DASHSCOPE_TTS_MODEL=qwen-audio-3.0-tts-plus

# ---------- 可灵 Kling（第三方模型，走专属 MaaS 端点）----------
# 到百炼控制台获取你的 WorkspaceId，替换下面 URL 的 {WorkspaceId}
DASHSCOPE_MAAS_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
KLING_IMAGE_MODEL=kling/kling-v3-omni-image-generation
KLING_VIDEO_MODEL=kling/kling-v3-video-generation
# 可灵 omni 视频模型：首帧图生视频 / 参考生视频
KLING_OMNI_VIDEO_MODEL=kling/kling-v3-omni-video-generation

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# 热重载会断开进行中的 SSE 长连接，漫剧长任务场景保持 0
RELOAD=0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 存储 ----------
SESSION_DATA_DIR=
WORKSPACE_DIR=
MEMORY_DIR=
# UI 可写的密钥覆盖（勿提交仓库）
# SECRETS_PATH=

# ---------- Agent loop ----------
AGENT_MAX_TURNS=64
CONTEXT_MAX_CHARS=24000
CONTEXT_KEEP_RECENT=12

# ---------- 后台渲染性能（S4）----------
# 出图/整集渲染 worker 池大小（同集互斥，跨集并行）
DRAMA_MAX_WORKERS=4
DRAMA_SHOT_CONCURRENCY=8
# 外部生成 provider 默认限流（次/分钟，0 表示不限）
DRAMA_RPM_DEFAULT=0

# ---------- 分镜出图 ----------
# pollinations 免费图生；none 则只用运镜底图；ark 预设用 seedream
IMAGE_GEN_PROVIDER=pollinations
IMAGE_GEN_MODEL=flux

# 角色一致性出图（S1）：配置后方启用真一致性模型（img2img/IP-Adapter）
# 契约：multipart POST { image(参考图,可多个), prompt, seed, width, height, model }
CONSISTENT_IMAGE_URL=
CONSISTENT_IMAGE_KEY=
CONSISTENT_IMAGE_MODEL=char-consistent

# ---------- I2V 运动（D8 + S2）----------
# none | mock | fail | http | kling | hailuo | seedance
I2V_PROVIDER=none
I2V_MODEL=default
# 真 I2V 自建网关：提交端点（multipart 提交，返回 job_id 或直接视频）
I2V_API_URL=
I2V_API_KEY=
I2V_POLL_INTERVAL=2.0
I2V_POLL_TIMEOUT=300.0
I2V_SECONDS=2.5

# ---------- 口型（质量优先，不惜代价）----------
# 级联：PixVerse(百炼 MaaS) → LatentSync(Replicate) → 自建 LIP_API_URL →（可选）mock
# latentsync | pixverse | musetalk | wav2lip | http | mock
LIP_PROVIDER=pixverse
LIP_QUALITY=max
LIP_ALLOW_MOCK=0
LIP_ENSURE_MOTION=1
LIP_INFERENCE_STEPS=30
LIP_GUIDANCE_SCALE=1.5
LIP_POLL_TIMEOUT=600
LIP_API_URL=
LIP_API_KEY=

# ByteDance LatentSync via Replicate（画质最高；约 $0.1+/镜）
REPLICATE_API_TOKEN=
REPLICATE_LIP_MODEL=bytedance/latentsync
# REPLICATE_LIP_VERSION=   # 可选：钉死模型 version hash

# PixVerse 对口型（需 DASHSCOPE_API_KEY + DASHSCOPE_MAAS_BASE_URL）
# PIXVERSE_LIP_MODEL=pixverse/pixverse-lipsync

# ---------- 高拟真 TTS（S3）----------
# 契约：POST TTS_API_URL（multipart: text, voice），返回 audio 字节流
TTS_API_URL=
TTS_API_KEY=

# ---------- 媒体工具 ----------
# ffmpeg / ffprobe / 中文字体按系统默认；必要时覆盖
FFMPEG_BIN=ffmpeg
TTS_VOICE=zh-CN-YunxiNeural
