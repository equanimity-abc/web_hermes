{
  "$defs": {
    "CastMember": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "gender": {
          "default": "other",
          "enum": [
            "male",
            "female",
            "other"
          ],
          "title": "Gender",
          "type": "string"
        },
        "age_band": {
          "default": "",
          "description": "如 18-22",
          "maxLength": 32,
          "title": "Age Band",
          "type": "string"
        },
        "look_full": {
          "description": "正面全身定妆一整句，可直接喂 Seedream",
          "maxLength": 400,
          "minLength": 20,
          "title": "Look Full",
          "type": "string"
        },
        "look_face": {
          "description": "正脸锚点一整句（瞳色/眉/痣等）",
          "maxLength": 200,
          "minLength": 8,
          "title": "Look Face",
          "type": "string"
        },
        "voice": {
          "description": "性别+年龄+音域+语速+情绪(+方言)",
          "maxLength": 200,
          "minLength": 8,
          "title": "Voice",
          "type": "string"
        },
        "voice_id": {
          "default": "",
          "title": "Voice Id",
          "type": "string"
        },
        "trait": {
          "default": "",
          "title": "Trait",
          "type": "string"
        },
        "catchphrase": {
          "default": "",
          "title": "Catchphrase",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "look_full",
        "look_face",
        "voice"
      ],
      "title": "CastMember",
      "type": "object"
    },
    "DialogueLine": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "description": "cast.id",
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "emotion": {
          "default": "",
          "title": "Emotion",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "text"
      ],
      "title": "DialogueLine",
      "type": "object"
    },
    "EpisodePack": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "maximum": 50,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seconds"
        },
        "beat": {
          "default": "",
          "description": "叙事节拍摘要，给人看",
          "title": "Beat",
          "type": "string"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/ShotSpec"
          },
          "title": "Shots",
          "type": "array"
        }
      },
      "required": [
        "n"
      ],
      "title": "EpisodePack",
      "type": "object"
    },
    "LocationSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "plate": {
          "description": "无人物竖屏空镜一整句，须含视频静帧用途",
          "maxLength": 500,
          "minLength": 20,
          "title": "Plate",
          "type": "string"
        },
        "light": {
          "maxLength": 120,
          "minLength": 4,
          "title": "Light",
          "type": "string"
        },
        "anchors": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Anchors",
          "type": "array"
        },
        "layout": {
          "default": "",
          "description": "前/中/后景",
          "maxLength": 200,
          "title": "Layout",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "plate",
        "light",
        "anchors"
      ],
      "title": "LocationSpec",
      "type": "object"
    },
    "PropSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "look": {
          "maxLength": 300,
          "minLength": 8,
          "title": "Look",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "look"
      ],
      "title": "PropSpec",
      "type": "object"
    },
    "SeriesMeta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "logline": {
          "default": "",
          "title": "Logline",
          "type": "string"
        },
        "aspect": {
          "const": "9:16",
          "default": "9:16",
          "title": "Aspect",
          "type": "string"
        },
        "seconds_per_episode": {
          "default": 60,
          "maximum": 180,
          "minimum": 15,
          "title": "Seconds Per Episode",
          "type": "integer"
        },
        "language": {
          "default": "zh-CN",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "SeriesMeta",
      "type": "object"
    },
    "SeriesStyle": {
      "additionalProperties": false,
      "description": "全片唯一视觉/声音总风格——下游只许原样粘贴。",
      "properties": {
        "visual": {
          "description": "全片画风一句，如：二次元赛璐璐竖屏短剧，清晰线稿，非写实",
          "maxLength": 200,
          "minLength": 8,
          "title": "Visual",
          "type": "string"
        },
        "palette": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Palette",
          "type": "array"
        },
        "camera_default": {
          "default": "中近景为主，少航拍",
          "title": "Camera Default",
          "type": "string"
        },
        "audio_default": {
          "default": "native",
          "enum": [
            "native",
            "tts",
            "silent"
          ],
          "title": "Audio Default",
          "type": "string"
        },
        "bgm_mood": {
          "default": "",
          "title": "Bgm Mood",
          "type": "string"
        },
        "bgm_instruments": {
          "default": "",
          "title": "Bgm Instruments",
          "type": "string"
        }
      },
      "required": [
        "visual"
      ],
      "title": "SeriesStyle",
      "type": "object"
    },
    "ShotSpec": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "maximum": 40,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        },
        "t_in": {
          "minimum": 0.0,
          "title": "T In",
          "type": "number"
        },
        "t_out": {
          "exclusiveMinimum": 0.0,
          "title": "T Out",
          "type": "number"
        },
        "kind": {
          "default": "dialogue",
          "enum": [
            "hook",
            "dialogue",
            "action",
            "reaction",
            "insert",
            "establishing",
            "title",
            "crowd"
          ],
          "title": "Kind",
          "type": "string"
        },
        "cast": {
          "items": {
            "type": "string"
          },
          "title": "Cast",
          "type": "array"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "props": {
          "items": {
            "type": "string"
          },
          "title": "Props",
          "type": "array"
        },
        "shot_size": {
          "enum": [
            "远景",
            "全景",
            "中景",
            "近景",
            "特写"
          ],
          "title": "Shot Size",
          "type": "string"
        },
        "camera": {
          "enum": [
            "推",
            "拉",
            "摇",
            "移",
            "跟",
            "升",
            "降",
            "环绕",
            "固定"
          ],
          "title": "Camera",
          "type": "string"
        },
        "still": {
          "description": "冻结静帧：只喂 Seedream，禁止过程词",
          "maxLength": 400,
          "minLength": 8,
          "title": "Still",
          "type": "string"
        },
        "motion": {
          "default": "",
          "description": "相对 still 的动作时序：只喂 Seedance；L0 静镜可空",
          "maxLength": 400,
          "title": "Motion",
          "type": "string"
        },
        "dialogue": {
          "items": {
            "$ref": "#/$defs/DialogueLine"
          },
          "title": "Dialogue",
          "type": "array"
        },
        "vo": {
          "default": "",
          "title": "Vo",
          "type": "string"
        },
        "sfx": {
          "default": "",
          "title": "Sfx",
          "type": "string"
        },
        "audio_mode": {
          "anyOf": [
            {
              "enum": [
                "native",
                "tts",
                "silent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Mode"
        }
      },
      "required": [
        "n",
        "t_in",
        "t_out",
        "location",
        "shot_size",
        "camera",
        "still"
      ],
      "title": "ShotSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "完整剧包：系列风格 + 资产规格 + 分集分镜。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/SeriesMeta"
    },
    "style": {
      "$ref": "#/$defs/SeriesStyle"
    },
    "cast": {
      "items": {
        "$ref": "#/$defs/CastMember"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Cast",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/LocationSpec"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Locations",
      "type": "array"
    },
    "props": {
      "items": {
        "$ref": "#/$defs/PropSpec"
      },
      "maxItems": 12,
      "title": "Props",
      "type": "array"
    },
    "relationships": {
      "description": "如：linwan → yugong：孙女",
      "items": {
        "type": "string"
      },
      "title": "Relationships",
      "type": "array"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/EpisodePack"
      },
      "title": "Episodes",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "style",
    "cast",
    "locations"
  ],
  "title": "SeriesPack",
  "type": "object"
}
